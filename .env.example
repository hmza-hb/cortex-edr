# =============================================================================
# CortexEDR — Environment Configuration
# Copy to .env.local for local development
# =============================================================================

# --- Application ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                          # Required. Min 32 characters.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Providers (at least OPENAI_API_KEY recommended) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- OAuth (Optional) ---
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub API (Optional — improves rate limits for public repo scans) ---
GITHUB_TOKEN=

# --- Billing — Paddle (Optional) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_DEVELOPER=
PADDLE_PRICE_ID_TEAMS=
PADDLE_PRICE_ID_ENTERPRISE=

# --- Email — Resend (Optional) ---
RESEND_API_KEY=

# --- Inngest (Optional — background jobs) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
